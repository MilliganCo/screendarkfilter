<Window x:Class="ScreenDarkFilter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenDarkFilter"
        Width="500"
        MaxHeight="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#243036"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SliderCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#0E1114" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="ScreenDarkFilter" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Тёмная тема поверх 1С, без правок конфигурации"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="#0E1114" Padding="18,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Text="Готово." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Padding="18,16" VerticalScrollBarVisibility="Auto" MaxHeight="640">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <CheckBox x:Name="EnabledBox" Content="Фильтр включён" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Ctrl+Alt+D"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <TextBlock Text="Куда применять" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <RadioButton x:Name="ModeOneC" Content="Только окна 1С (1cv8c.exe)"/>
                    <RadioButton x:Name="ModeMonitor" Content="Выбранный монитор"/>
                    <RadioButton x:Name="ModeDesktop" Content="Весь рабочий стол"/>
                    <ComboBox x:Name="MonitorBox" DisplayMemberPath="Title"/>

                    <TextBlock Text="Тема" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <ComboBox x:Name="ThemeBox" DisplayMemberPath="Name"/>
                    <TextBlock x:Name="ThemeHint" Style="{StaticResource Hint}"/>

                    <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <UniformGrid Columns="6">
                        <Border x:Name="ChipWhite" Height="28" Margin="0,0,6,0" CornerRadius="4"/>
                        <Border x:Name="ChipPanel" Height="28" Margin="0,0,6,0" CornerRadius="4"/>
                        <Border x:Name="ChipText" Height="28" Margin="0,0,6,0" CornerRadius="4"/>
                        <Border x:Name="ChipCyan" Height="28" Margin="0,0,6,0" CornerRadius="4"/>
                        <Border x:Name="ChipGreen" Height="28" Margin="0,0,6,0" CornerRadius="4"/>
                        <Border x:Name="ChipYellow" Height="28" CornerRadius="4"/>
                    </UniformGrid>
                    <TextBlock Text="Белый / панель / текст / голубой / зелёный / жёлтый"
                               Style="{StaticResource Hint}"
                               FontSize="11"/>

                    <TextBlock Text="Тон" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    <TextBlock x:Name="StrengthCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="StrengthSlider"/>
                    <TextBlock x:Name="BackgroundCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="BackgroundSlider"/>
                    <TextBlock x:Name="TextCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="TextSlider"/>
                    <TextBlock x:Name="ContrastCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="ContrastSlider"/>
                    <TextBlock x:Name="SaturationCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="SaturationSlider"/>
                    <TextBlock x:Name="WarmthCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="WarmthSlider"/>
                    <TextBlock x:Name="MidtonesCaption" Style="{StaticResource SliderCaption}"/>
                    <Slider x:Name="MidtonesSlider"/>

                    <TextBlock Text="Поведение" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <CheckBox x:Name="SoftenBox" Content="Смягчить свечение текста 1С"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Пока фильтр включён, ClearType временно меняется на обычное сглаживание — цветная кайма глифов меньше «светится». При выключении фильтра Windows вернёт как было."/>
                    <CheckBox x:Name="OnlyOneCBox" Content="Держать фильтр только когда 1С на переднем плане"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Смотрит, видно ли окно 1С и не перекрыто ли оно другим приложением. Фокус может быть в настройках или на другом мониторе — фильтр останется."/>
                    <CheckBox x:Name="ThickClientBox" Content="Захватывать и толстый клиент 1cv8.exe"/>
                    <CheckBox x:Name="StartupBox" Content="Запускать вместе с Windows"/>
                    <CheckBox x:Name="TrayBox" Content="При закрытии оставлять в трее"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                        <Button x:Name="ResetSlidersButton" Content="Сброс к теме"/>
                        <Button x:Name="DisableButton" Content="Снять фильтр"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
