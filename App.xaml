<Application x:Class="ScreenDarkFilter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#121417"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1F24"/>
        <SolidColorBrush x:Key="LineBrush" Color="#2A3138"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7EBF0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A0AB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F9E8C"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#1E6F64"/>
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    </Application.Resources>
</Application>
